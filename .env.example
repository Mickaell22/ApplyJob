# ── IA ────────────────────────────────────────────────────────────────────────
# DeepSeek API key: https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=sk-...

# ── Correo ────────────────────────────────────────────────────────────────────
# Gmail App Password (requiere 2FA activado):
# https://myaccount.google.com/apppasswords
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── CVs en PDF ────────────────────────────────────────────────────────────────
# Pon tus PDFs en la carpeta profile/ con estos nombres (o cambia las rutas)
CV_PATH=./profile/cv.pdf
CV_PATH_EN=./profile/cv_en.pdf

# ── Datos del candidato ───────────────────────────────────────────────────────
# Usados en cartas de presentación y formularios ATS
CANDIDATE_NAME=Tu Nombre Completo
CANDIDATE_PHONE=+1 234 567 8900
CANDIDATE_LOCATION=Ciudad, País
CANDIDATE_CITY=Ciudad
CANDIDATE_COUNTRY=País
CANDIDATE_LINKEDIN=https://linkedin.com/in/tu-perfil
CANDIDATE_GITHUB=https://github.com/tu-usuario
CANDIDATE_WEBSITE=https://tu-portafolio.com

# ── Región geográfica ─────────────────────────────────────────────────────────
# Filtra ofertas que no están disponibles para tu ubicación
# Opciones: LATAM (default), EUROPE, ASIA, USA, GLOBAL
CANDIDATE_REGION=LATAM

# ── Canal local (opcional) ────────────────────────────────────────────────────
# Subdominio de Computrabajo de tu pais (ec, mx, co, pe, ...) para el board
# local; el canal local tambien usa CANDIDATE_COUNTRY para LinkedIn local
COMPUTRABAJO_DOMAIN=ec.computrabajo.com

# ── GetOnBrd (opcional) ───────────────────────────────────────────────────────
# Solo necesario si usas auto-apply en GetOnBrd (ver setup_gob_session.py)
GETONBRD_SESSION_PATH=./.gob_session.json
